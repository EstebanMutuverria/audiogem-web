# WhatsApp Business API (Meta Cloud API) Configuration
# Copy this file to .env and fill in your values

# Meta Webhook Verification Token (minimum 10 characters)
# Set this in Meta Developer Dashboard > WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=your-verify-token-min-10-chars

# Meta App Secret (from Meta App Dashboard > Settings > Basic)
# Used for HMAC-SHA256 signature validation of incoming webhooks
WHATSAPP_APP_SECRET=your-app-secret-from-meta

# Meta Access Token (from Meta Business Manager > WhatsApp > API Setup)
# Bearer token for sending messages via Graph API
WHATSAPP_ACCESS_TOKEN=your-access-token-from-meta

# WhatsApp Business Phone Number ID (from Meta Business Manager > WhatsApp > API Setup)
# Numeric string identifier for the phone number
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Server Configuration
PORT=3000
NODE_ENV=development

# Auto-reply message (optional - defaults to Spanish greeting)
# AUTO_REPLY_TEXT=Hola! 👋 Soy el asistente de AudioGem. Recibimos tu consulta y en breve te respondemos. ¡Gracias por escribirnos!